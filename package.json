{
  "name": "brnd-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && cp vercel.json dist/vercel.json",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "lint:strict": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:runtime-logs": "rg -n \"(console\\.log\\(|logger\\.debug\\(|console\\.error\\()\" src --glob '!src/pages/AirdropPage/**' --glob '!src/shared/hooks/contract/useAirdropClaim.ts' --glob '!src/shared/hooks/user/useAirdropClaimStatus.ts' --glob '!src/shared/utils/logger.ts' && (echo 'Runtime logs policy violation found' && exit 1) || (echo 'Runtime logs policy passed' && exit 0)",
    "lint:styles": "node scripts/check-scss-modules.mjs",
    "lint:styles:strict": "node scripts/check-scss-modules.mjs --strict",
    "cutover:check-env": "node scripts/cutover-check-env.mjs",
    "cutover:smoke": "node scripts/cutover-smoke.mjs",
    "preview": "vite preview",
    "optimize:png": "node scripts/optimize-pngs.mjs",
    "optimize:png:check": "node scripts/optimize-pngs.mjs --check"
  },
  "dependencies": {
    "@farcaster/auth-kit": "^0.6.0",
    "@farcaster/miniapp-sdk": "^0.2.0",
    "@farcaster/miniapp-wagmi-connector": "^1.1.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tanstack/react-query": "^5.45.1",
    "axios": "^1.7.2",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "ethers": "5",
    "framer-motion": "^11.2.10",
    "gsap": "^3.14.2",
    "lucide-react": "^0.562.0",
    "orbiter-cli": "^0.9.11",
    "react": "^18.2.0",
    "react-confetti": "^6.1.0",
    "react-confetti-boom": "^2.0.1",
    "react-dom": "^18.2.0",
    "react-icons": "^5.2.1",
    "react-router-dom": "^6.23.1",
    "react-use": "^17.5.0",
    "tw-animate-css": "^1.4.0",
    "wagmi": "^2.18.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^5.43.1",
    "@types/date-fns": "^2.6.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "eruda": "^3.4.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "sass": "^1.77.5",
    "typescript": "^5.2.2",
    "viem": "^2.38.2",
    "vite": "^5.2.0",
    "vite-plugin-node-polyfills": "^0.22.0",
    "vite-plugin-svgr": "^4.2.0",
    "vite-tsconfig-paths": "^4.3.2"
  }
}
